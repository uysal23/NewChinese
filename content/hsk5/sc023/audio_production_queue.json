      "type": "sentence",
      "voiceId": "VOICE_LI_NA_001",
      "textZh": "那我想先列出目标、资源、风险和机会。",
      "emotion": "natural"
    },
    {
      "order": 53,
      "file": "hsk5_sc023_sentence_009.m4a",
