{
  "sceneId": "HSK1_SC046",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK1_SC046_L001",
      "order": 1,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "今天我们在这里学习吧。",
      "pinyin": "Jīntiān wǒmen zài zhèlǐ xuéxí ba.",
      "translationTr": "Bugün burada çalışalım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc046_line_001.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L002",
      "order": 2,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "好，这里很安静。",
      "pinyin": "Hǎo, zhèlǐ hěn ānjìng.",
      "translationTr": "Tamam, burası çok sakin.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc046_line_002.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L003",
      "order": 3,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我带了笔记本。",
      "pinyin": "Wǒ dài le bǐjìběn.",
      "translationTr": "Defterimi getirdim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc046_line_003.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L004",
      "order": 4,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你想复习什么？",
      "pinyin": "Nǐ xiǎng fùxí shénme?",
      "translationTr": "Neyi tekrar etmek istiyorsun?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc046_line_004.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L005",
      "order": 5,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我想复习时间和方向。",
      "pinyin": "Wǒ xiǎng fùxí shíjiān hé fāngxiàng.",
      "translationTr": "Saat ve yönleri tekrar etmek istiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc046_line_005.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L006",
      "order": 6,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "好，我来问你问题。",
      "pinyin": "Hǎo, wǒ lái wèn nǐ wèntí.",
      "translationTr": "Tamam, sana sorular sorayım.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc046_line_006.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L007",
      "order": 7,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "可以，开始吧。",
      "pinyin": "Kěyǐ, kāishǐ ba.",
      "translationTr": "Olur, başlayalım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc046_line_007.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L008",
      "order": 8,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "现在几点？",
      "pinyin": "Xiànzài jǐ diǎn?",
      "translationTr": "Şimdi saat kaç?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc046_line_008.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L009",
      "order": 9,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "现在三点半。",
      "pinyin": "Xiànzài sān diǎn bàn.",
      "translationTr": "Şimdi saat üç buçuk.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc046_line_009.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L010",
      "order": 10,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "很好。车站在哪边？",
      "pinyin": "Hěn hǎo. Chēzhàn zài nǎbiān?",
      "translationTr": "Çok iyi. İstasyon hangi tarafta?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc046_line_010.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L011",
      "order": 11,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "在前面左边。",
      "pinyin": "Zài qiánmiàn zuǒbian.",
      "translationTr": "Önde, solda.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc046_line_011.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L012",
      "order": 12,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你记得很清楚。",
      "pinyin": "Nǐ jìde hěn qīngchu.",
      "translationTr": "Çok net hatırlıyorsun.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc046_line_012.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L013",
      "order": 13,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "因为我们每天都练习。",
      "pinyin": "Yīnwèi wǒmen měitiān dōu liànxí.",
      "translationTr": "Çünkü her gün pratik yapıyoruz.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc046_line_013.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC046_L014",
      "order": 14,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "继续加油。",
      "pinyin": "Jìxù jiāyóu.",
      "translationTr": "Böyle devam et.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc046_line_014.m4a",
      "emotion": "natural"
    }
  ]
}
