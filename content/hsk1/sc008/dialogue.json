{
  "sceneId": "HSK1_SC008",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK1_SC008_L001",
      "order": 1,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "今天第一天，感觉怎么样？",
      "pinyin": "Jīntiān dì yī tiān, gǎnjué zěnmeyàng?",
      "translationTr": "Bugün ilk günün, nasıl hissediyorsun?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc008_line_001.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L002",
      "order": 2,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "很好，就是有一点累。",
      "pinyin": "Hěn hǎo, jiùshì yǒu yìdiǎn lèi.",
      "translationTr": "Çok iyi, sadece biraz yorgunum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc008_line_002.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L003",
      "order": 3,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "坐了那么久的车，累很正常。",
      "pinyin": "Zuò le nàme jiǔ de chē, lèi hěn zhèngcháng.",
      "translationTr": "O kadar uzun yolculuktan sonra yorulman normal.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc008_line_003.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L004",
      "order": 4,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "不过我很高兴来到杭州。",
      "pinyin": "Bùguò wǒ hěn gāoxìng láidào Hángzhōu.",
      "translationTr": "Ama Hangzhou'ya geldiğim için çok mutluyum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc008_line_004.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L005",
      "order": 5,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "以后这里就是你的家了。",
      "pinyin": "Yǐhòu zhèlǐ jiù shì nǐ de jiā le.",
      "translationTr": "Bundan sonra burası senin evin olacak.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc008_line_005.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L006",
      "order": 6,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "听起来真不错。",
      "pinyin": "Tīng qǐlái zhēn búcuò.",
      "translationTr": "Kulağa gerçekten güzel geliyor.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc008_line_006.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L007",
      "order": 7,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "回家以后先休息。",
      "pinyin": "Huí jiā yǐhòu xiān xiūxi.",
      "translationTr": "Eve dönünce önce dinlen.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc008_line_007.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L008",
      "order": 8,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，我想先洗个澡。",
      "pinyin": "Hǎo, wǒ xiǎng xiān xǐ ge zǎo.",
      "translationTr": "Tamam, önce duş almak istiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc008_line_008.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L009",
      "order": 9,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "然后吃一点东西。",
      "pinyin": "Ránhòu chī yìdiǎn dōngxi.",
      "translationTr": "Sonra biraz bir şeyler ye.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc008_line_009.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L010",
      "order": 10,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "家里有吃的吗？",
      "pinyin": "Jiālǐ yǒu chī de ma?",
      "translationTr": "Evde yiyecek var mı?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc008_line_010.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L011",
      "order": 11,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "有，我准备了一些。",
      "pinyin": "Yǒu, wǒ zhǔnbèi le yìxiē.",
      "translationTr": "Var, biraz hazırladım.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc008_line_011.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L012",
      "order": 12,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "太好了，谢谢你。",
      "pinyin": "Tài hǎo le, xièxie nǐ.",
      "translationTr": "Harika, teşekkür ederim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc008_line_012.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L013",
      "order": 13,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "今天不用想工作的事。",
      "pinyin": "Jīntiān bú yòng xiǎng gōngzuò de shì.",
      "translationTr": "Bugün işi düşünmene gerek yok.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc008_line_013.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L014",
      "order": 14,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "对，今天只想好好休息。",
      "pinyin": "Duì, jīntiān zhǐ xiǎng hǎohāo xiūxi.",
      "translationTr": "Evet, bugün sadece güzelce dinlenmek istiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc008_line_014.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L015",
      "order": 15,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "明天再慢慢来。",
      "pinyin": "Míngtiān zài mànmàn lái.",
      "translationTr": "Yarın yavaş yavaş devam ederiz.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc008_line_015.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC008_L016",
      "order": 16,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，我听你的。",
      "pinyin": "Hǎo, wǒ tīng nǐ de.",
      "translationTr": "Tamam, seni dinleyeceğim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc008_line_016.m4a",
      "emotion": "natural"
    }
  ]
}
