{
  "sceneId": "HSK1_SC011",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK1_SC011_L001",
      "order": 1,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "早上好，你起床了吗？",
      "pinyin": "Zǎoshang hǎo, nǐ qǐchuáng le ma?",
      "translationTr": "Günaydın, kalktın mı?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc011_line_001.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L002",
      "order": 2,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "早上好，刚起来。",
      "pinyin": "Zǎoshang hǎo, gāng qǐlái.",
      "translationTr": "Günaydın, yeni kalktım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc011_line_002.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L003",
      "order": 3,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "昨天晚上睡得好吗？",
      "pinyin": "Zuótiān wǎnshang shuì de hǎo ma?",
      "translationTr": "Dün gece iyi uyudun mu?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc011_line_003.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L004",
      "order": 4,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "睡得很好，就是有点晚。",
      "pinyin": "Shuì de hěn hǎo, jiùshì yǒudiǎn wǎn.",
      "translationTr": "İyi uyudum, sadece biraz geç oldu.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc011_line_004.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L005",
      "order": 5,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "今天不用早起，慢慢来。",
      "pinyin": "Jīntiān bú yòng zǎoqǐ, mànmàn lái.",
      "translationTr": "Bugün erken kalkmana gerek yok, acele etme.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc011_line_005.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L006",
      "order": 6,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我已经不太累了。",
      "pinyin": "Wǒ yǐjīng bú tài lèi le.",
      "translationTr": "Artık pek yorgun değilim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc011_line_006.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L007",
      "order": 7,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "那很好。先洗脸吧。",
      "pinyin": "Nà hěn hǎo. Xiān xǐliǎn ba.",
      "translationTr": "Çok iyi. Önce yüzünü yıka.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc011_line_007.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L008",
      "order": 8,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，然后我喝点水。",
      "pinyin": "Hǎo, ránhòu wǒ hē diǎn shuǐ.",
      "translationTr": "Tamam, sonra biraz su içerim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc011_line_008.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L009",
      "order": 9,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "窗户可以打开，早上空气很好。",
      "pinyin": "Chuānghu kěyǐ dǎkāi, zǎoshang kōngqì hěn hǎo.",
      "translationTr": "Pencereyi açabilirsin, sabah hava çok güzel.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc011_line_009.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L010",
      "order": 10,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "真的，今天很舒服。",
      "pinyin": "Zhēn de, jīntiān hěn shūfu.",
      "translationTr": "Gerçekten, bugün çok rahat.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc011_line_010.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L011",
      "order": 11,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你饿了吗？",
      "pinyin": "Nǐ è le ma?",
      "translationTr": "Acıktın mı?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc011_line_011.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L012",
      "order": 12,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "有一点。",
      "pinyin": "Yǒu yìdiǎn.",
      "translationTr": "Biraz.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc011_line_012.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L013",
      "order": 13,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "那我们一会儿吃早饭。",
      "pinyin": "Nà wǒmen yíhuìr chī zǎofàn.",
      "translationTr": "O zaman birazdan kahvaltı yaparız.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc011_line_013.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L014",
      "order": 14,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，我先收拾一下。",
      "pinyin": "Hǎo, wǒ xiān shōushi yíxià.",
      "translationTr": "Tamam, önce biraz toparlanayım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc011_line_014.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L015",
      "order": 15,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "不着急，我等你。",
      "pinyin": "Bù zháojí, wǒ děng nǐ.",
      "translationTr": "Acele etme, seni beklerim.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc011_line_015.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC011_L016",
      "order": 16,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，十分钟就好。",
      "pinyin": "Hǎo, shí fēnzhōng jiù hǎo.",
      "translationTr": "Tamam, on dakika yeter.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc011_line_016.m4a",
      "emotion": "natural"
    }
  ]
}
