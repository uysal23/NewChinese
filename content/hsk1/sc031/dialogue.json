{
  "sceneId": "HSK1_SC031",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK1_SC031_L001",
      "order": 1,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你家有几口人？",
      "pinyin": "Nǐ jiā yǒu jǐ kǒu rén?",
      "translationTr": "Ailende kaç kişi var?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc031_line_001.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L002",
      "order": 2,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我家有四口人。",
      "pinyin": "Wǒ jiā yǒu sì kǒu rén.",
      "translationTr": "Ailemde dört kişi var.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc031_line_002.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L003",
      "order": 3,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "都有谁？",
      "pinyin": "Dōu yǒu shéi?",
      "translationTr": "Kimler var?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc031_line_003.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L004",
      "order": 4,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "爸爸、妈妈、妹妹和我。",
      "pinyin": "Bàba, māma, mèimei hé wǒ.",
      "translationTr": "Babam, annem, kız kardeşim ve ben.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc031_line_004.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L005",
      "order": 5,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你妹妹多大？",
      "pinyin": "Nǐ mèimei duō dà?",
      "translationTr": "Kız kardeşin kaç yaşında?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc031_line_005.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L006",
      "order": 6,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "她二十二岁。",
      "pinyin": "Tā èrshí'èr suì.",
      "translationTr": "Yirmi iki yaşında.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc031_line_006.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L007",
      "order": 7,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "她也住在杭州吗？",
      "pinyin": "Tā yě zhù zài Hángzhōu ma?",
      "translationTr": "O da Hangzhou'da mı yaşıyor?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc031_line_007.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L008",
      "order": 8,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "不，她住在上海。",
      "pinyin": "Bù, tā zhù zài Shànghǎi.",
      "translationTr": "Hayır, Şanghay'da yaşıyor.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc031_line_008.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L009",
      "order": 9,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你常给家里打电话吗？",
      "pinyin": "Nǐ cháng gěi jiālǐ dǎ diànhuà ma?",
      "translationTr": "Aileni sık arar mısın?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc031_line_009.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L010",
      "order": 10,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "常打，周末一定打。",
      "pinyin": "Cháng dǎ, zhōumò yídìng dǎ.",
      "translationTr": "Sık ararım, hafta sonu mutlaka ararım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc031_line_010.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L011",
      "order": 11,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你们关系很好。",
      "pinyin": "Nǐmen guānxi hěn hǎo.",
      "translationTr": "Aranız çok iyi.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc031_line_011.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L012",
      "order": 12,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "对，我们常聊天。",
      "pinyin": "Duì, wǒmen cháng liáotiān.",
      "translationTr": "Evet, sık sık sohbet ederiz.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc031_line_012.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L013",
      "order": 13,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "下次给我看看你们的照片吧。",
      "pinyin": "Xià cì gěi wǒ kànkan nǐmen de zhàopiàn ba.",
      "translationTr": "Bir dahaki sefere fotoğraflarınızı göster.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc031_line_013.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC031_L014",
      "order": 14,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，我有很多家庭照片。",
      "pinyin": "Hǎo, wǒ yǒu hěn duō jiātíng zhàopiàn.",
      "translationTr": "Olur, çok aile fotoğrafım var.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc031_line_014.m4a",
      "emotion": "natural"
    }
  ]
}
