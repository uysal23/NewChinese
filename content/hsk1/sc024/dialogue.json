{
  "sceneId": "HSK1_SC024",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK1_SC024_L001",
      "order": 1,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "这里有一家便利店。",
      "pinyin": "Zhèlǐ yǒu yì jiā biànlìdiàn.",
      "translationTr": "Burada bir mini market var.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc024_line_001.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L002",
      "order": 2,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "正好，我想买几样东西。",
      "pinyin": "Zhènghǎo, wǒ xiǎng mǎi jǐ yàng dōngxi.",
      "translationTr": "İyi oldu, birkaç şey almak istiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc024_line_002.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L003",
      "order": 3,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你需要什么？",
      "pinyin": "Nǐ xūyào shénme?",
      "translationTr": "Neye ihtiyacın var?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc024_line_003.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L004",
      "order": 4,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "水、纸巾，还有电池。",
      "pinyin": "Shuǐ, zhǐjīn, hái yǒu diànchí.",
      "translationTr": "Su, mendil ve pil.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc024_line_004.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L005",
      "order": 5,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "水在右边的冰箱里。",
      "pinyin": "Shuǐ zài yòubian de bīngxiāng lǐ.",
      "translationTr": "Su sağdaki buzdolabında.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc024_line_005.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L006",
      "order": 6,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我要两瓶常温的。",
      "pinyin": "Wǒ yào liǎng píng chángwēn de.",
      "translationTr": "Oda sıcaklığında iki şişe istiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc024_line_006.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L007",
      "order": 7,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "纸巾在前面的架子上。",
      "pinyin": "Zhǐjīn zài qiánmiàn de jiàzi shàng.",
      "translationTr": "Mendiller öndeki rafta.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc024_line_007.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L008",
      "order": 8,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "这种可以吗？",
      "pinyin": "Zhè zhǒng kěyǐ ma?",
      "translationTr": "Bu çeşit olur mu?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc024_line_008.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L009",
      "order": 9,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "可以，一包就够了。",
      "pinyin": "Kěyǐ, yì bāo jiù gòu le.",
      "translationTr": "Olur, bir paket yeter.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc024_line_009.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L010",
      "order": 10,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "电池在哪里？",
      "pinyin": "Diànchí zài nǎli?",
      "translationTr": "Piller nerede?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc024_line_010.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L011",
      "order": 11,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "收银台旁边。",
      "pinyin": "Shōuyíntái pángbiān.",
      "translationTr": "Kasanın yanında.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc024_line_011.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L012",
      "order": 12,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "这个多少钱？",
      "pinyin": "Zhège duōshao qián?",
      "translationTr": "Bu ne kadar?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc024_line_012.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L013",
      "order": 13,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "标签上写着十二块。",
      "pinyin": "Biāoqiān shàng xiězhe shí'èr kuài.",
      "translationTr": "Etiketinde 12 yuan yazıyor.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc024_line_013.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L014",
      "order": 14,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，都拿上吧。",
      "pinyin": "Hǎo, dōu ná shàng ba.",
      "translationTr": "Tamam, hepsini alalım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc024_line_014.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L015",
      "order": 15,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "还需要别的吗？",
      "pinyin": "Hái xūyào bié de ma?",
      "translationTr": "Başka bir şeye ihtiyacın var mı?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc024_line_015.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC024_L016",
      "order": 16,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "不用了，这些就够了。",
      "pinyin": "Bú yòng le, zhèxiē jiù gòu le.",
      "translationTr": "Gerek yok, bunlar yeter.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc024_line_016.m4a",
      "emotion": "natural"
    }
  ]
}
