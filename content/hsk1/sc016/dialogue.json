{
  "sceneId": "HSK1_SC016",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK1_SC016_L001",
      "order": 1,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "东西都买好了，我们做午饭吧。",
      "pinyin": "Dōngxi dōu mǎi hǎo le, wǒmen zuò wǔfàn ba.",
      "translationTr": "Her şeyi aldık, öğle yemeği yapalım.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc016_line_001.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L002",
      "order": 2,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，我能帮什么？",
      "pinyin": "Hǎo, wǒ néng bāng shénme?",
      "translationTr": "Tamam, neye yardım edebilirim?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc016_line_002.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L003",
      "order": 3,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你先洗菜，我来做米饭。",
      "pinyin": "Nǐ xiān xǐ cài, wǒ lái zuò mǐfàn.",
      "translationTr": "Önce sebzeleri yıka, pirinci ben yapayım.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc016_line_003.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L004",
      "order": 4,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "这些菜都要洗吗？",
      "pinyin": "Zhèxiē cài dōu yào xǐ ma?",
      "translationTr": "Bu sebzelerin hepsini yıkayayım mı?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc016_line_004.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L005",
      "order": 5,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "对，西红柿和黄瓜都洗一下。",
      "pinyin": "Duì, xīhóngshì hé huángguā dōu xǐ yíxià.",
      "translationTr": "Evet, domatesleri ve salatalıkları yıka.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc016_line_005.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L006",
      "order": 6,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "洗好了，放哪里？",
      "pinyin": "Xǐ hǎo le, fàng nǎli?",
      "translationTr": "Yıkadım, nereye koyayım?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc016_line_006.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L007",
      "order": 7,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "放在这个盘子里。",
      "pinyin": "Fàng zài zhège pánzi lǐ.",
      "translationTr": "Bu tabağa koy.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc016_line_007.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L008",
      "order": 8,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我会切黄瓜。",
      "pinyin": "Wǒ huì qiē huángguā.",
      "translationTr": "Salatalık doğrayabilirim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc016_line_008.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L009",
      "order": 9,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "好，小心刀。",
      "pinyin": "Hǎo, xiǎoxīn dāo.",
      "translationTr": "Tamam, bıçağa dikkat et.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc016_line_009.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L010",
      "order": 10,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "米饭还要多久？",
      "pinyin": "Mǐfàn hái yào duō jiǔ?",
      "translationTr": "Pirinç daha ne kadar sürer?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc016_line_010.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L011",
      "order": 11,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "大概十五分钟。",
      "pinyin": "Dàgài shíwǔ fēnzhōng.",
      "translationTr": "Yaklaşık on beş dakika.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc016_line_011.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L012",
      "order": 12,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "那我先做一个沙拉。",
      "pinyin": "Nà wǒ xiān zuò yí ge shālā.",
      "translationTr": "O zaman önce bir salata yapayım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc016_line_012.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L013",
      "order": 13,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "很好，再放一点盐。",
      "pinyin": "Hěn hǎo, zài fàng yìdiǎn yán.",
      "translationTr": "Çok iyi, biraz da tuz koy.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc016_line_013.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L014",
      "order": 14,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "这样可以吗？",
      "pinyin": "Zhèyàng kěyǐ ma?",
      "translationTr": "Böyle olur mu?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc016_line_014.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L015",
      "order": 15,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "可以，味道一定不错。",
      "pinyin": "Kěyǐ, wèidào yídìng búcuò.",
      "translationTr": "Olur, tadı kesin güzel olacak.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc016_line_015.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK1_SC016_L016",
      "order": 16,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "第一次在新家做饭，很有意思。",
      "pinyin": "Dì yī cì zài xīn jiā zuòfàn, hěn yǒuyìsi.",
      "translationTr": "Yeni evde ilk kez yemek yapmak çok güzel.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc016_line_016.m4a",
      "emotion": "natural"
    }
  ]
}
