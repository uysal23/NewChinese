{
  "sceneId": "HSK1_SC002",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK1_SC002_L001",
      "order": 1,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "对了，你的中文名字是张伟，对吗？",
      "pinyin": "Duì le, nǐ de Zhōngwén míngzi shì Zhāng Wěi, duì ma?",
      "translationTr": "Bu arada, Çince adın Zhang Wei, değil mi?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc002_line_001.m4a",
      "emotion": "friendly"
    },
    {
      "lineId": "HSK1_SC002_L002",
      "order": 2,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "对，是张伟。你叫李娜，对吧？",
      "pinyin": "Duì, shì Zhāng Wěi. Nǐ jiào Lǐ Nà, duì ba?",
      "translationTr": "Evet, Zhang Wei. Senin adın Li Na, değil mi?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc002_line_002.m4a",
      "emotion": "friendly"
    },
    {
      "lineId": "HSK1_SC002_L003",
      "order": 3,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "我叫李娜。朋友也叫我娜娜。",
      "pinyin": "Wǒ jiào Lǐ Nà. Péngyou yě jiào wǒ Nànà.",
      "translationTr": "Benim adım Li Na. Arkadaşlarım bana Nana da der.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc002_line_003.m4a",
      "emotion": "friendly"
    },
    {
      "lineId": "HSK1_SC002_L004",
      "order": 4,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "娜娜？这个名字很好听。",
      "pinyin": "Nànà? Zhège míngzi hěn hǎotīng.",
      "translationTr": "Nana mı? Bu isim kulağa çok hoş geliyor.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc002_line_004.m4a",
      "emotion": "happy"
    },
    {
      "lineId": "HSK1_SC002_L005",
      "order": 5,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "谢谢。你有英文名字吗？",
      "pinyin": "Xièxie. Nǐ yǒu Yīngwén míngzi ma?",
      "translationTr": "Teşekkür ederim. İngilizce bir adın var mı?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc002_line_005.m4a",
      "emotion": "friendly"
    },
    {
      "lineId": "HSK1_SC002_L006",
      "order": 6,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "有，我叫 John，不过我想多用中文名字。",
      "pinyin": "Yǒu, wǒ jiào John, bùguò wǒ xiǎng duō yòng Zhōngwén míngzi.",
      "translationTr": "Var, adım John; ama Çince adımı daha çok kullanmak istiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc002_line_006.m4a",
      "emotion": "calm"
    },
    {
      "lineId": "HSK1_SC002_L007",
      "order": 7,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你喜欢中文名字吗？",
      "pinyin": "Nǐ xǐhuan Zhōngwén míngzi ma?",
      "translationTr": "Çince adını seviyor musun?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc002_line_007.m4a",
      "emotion": "curious"
    },
    {
      "lineId": "HSK1_SC002_L008",
      "order": 8,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "喜欢。我在中国，想多说中文。",
      "pinyin": "Xǐhuan. Wǒ zài Zhōngguó, xiǎng duō shuō Zhōngwén.",
      "translationTr": "Seviyorum. Çin'deyken daha çok Çince konuşmak istiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc002_line_008.m4a",
      "emotion": "happy"
    },
    {
      "lineId": "HSK1_SC002_L009",
      "order": 9,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "好啊，那我以后就叫你张伟。",
      "pinyin": "Hǎo a, nà wǒ yǐhòu jiù jiào nǐ Zhāng Wěi.",
      "translationTr": "Olur, o zaman bundan sonra sana Zhang Wei diyeceğim.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc002_line_009.m4a",
      "emotion": "warm"
    },
    {
      "lineId": "HSK1_SC002_L010",
      "order": 10,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好。那我可以叫你娜娜吗？",
      "pinyin": "Hǎo. Nà wǒ kěyǐ jiào nǐ Nànà ma?",
      "translationTr": "Tamam. Peki sana Nana diyebilir miyim?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc002_line_010.m4a",
      "emotion": "friendly"
    },
    {
      "lineId": "HSK1_SC002_L011",
      "order": 11,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "可以。叫我娜娜就好。",
      "pinyin": "Kěyǐ. Jiào wǒ Nànà jiù hǎo.",
      "translationTr": "Olur. Bana Nana demen yeterli.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc002_line_011.m4a",
      "emotion": "happy"
    },
    {
      "lineId": "HSK1_SC002_L012",
      "order": 12,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，娜娜。很高兴认识你。",
      "pinyin": "Hǎo, Nànà. Hěn gāoxìng rènshi nǐ.",
      "translationTr": "Tamam, Nana. Tanıştığımıza çok memnun oldum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc002_line_012.m4a",
      "emotion": "happy"
    },
    {
      "lineId": "HSK1_SC002_L013",
      "order": 13,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "我也很高兴认识你，张伟。",
      "pinyin": "Wǒ yě hěn gāoxìng rènshi nǐ, Zhāng Wěi.",
      "translationTr": "Ben de seninle tanıştığıma çok memnun oldum, Zhang Wei.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc002_line_013.m4a",
      "emotion": "happy"
    },
    {
      "lineId": "HSK1_SC002_L014",
      "order": 14,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我的名字容易记吗？",
      "pinyin": "Wǒ de míngzi róngyì jì ma?",
      "translationTr": "Benim adımı hatırlamak kolay mı?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc002_line_014.m4a",
      "emotion": "curious"
    },
    {
      "lineId": "HSK1_SC002_L015",
      "order": 15,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "很容易，我记住了。",
      "pinyin": "Hěn róngyì, wǒ jìzhù le.",
      "translationTr": "Çok kolay, aklımda kaldı.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc002_line_015.m4a",
      "emotion": "friendly"
    },
    {
      "lineId": "HSK1_SC002_L016",
      "order": 16,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "那太好了。",
      "pinyin": "Nà tài hǎo le.",
      "translationTr": "Harika o zaman.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc002_line_016.m4a",
      "emotion": "happy"
    },
    {
      "lineId": "HSK1_SC002_L017",
      "order": 17,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "走吧，张伟。我们出去吧。",
      "pinyin": "Zǒu ba, Zhāng Wěi. Wǒmen chūqu ba.",
      "translationTr": "Hadi Zhang Wei, dışarı çıkalım.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc002_line_017.m4a",
      "emotion": "warm"
    },
    {
      "lineId": "HSK1_SC002_L018",
      "order": 18,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，娜娜。我们走吧。",
      "pinyin": "Hǎo, Nànà. Wǒmen zǒu ba.",
      "translationTr": "Tamam Nana, hadi gidelim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc002_line_018.m4a",
      "emotion": "happy"
    }
  ]
}
