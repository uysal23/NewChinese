{
  "sceneId": "HSK1_SC003",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK1_SC003_L001",
      "order": 1,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "张伟，我们从这边出去。",
      "pinyin": "Zhāng Wěi, wǒmen cóng zhèbiān chūqu.",
      "translationTr": "Zhang Wei, buradan çıkalım.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc003_line_001.m4a",
      "emotion": "helpful"
    },
    {
      "lineId": "HSK1_SC003_L002",
      "order": 2,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好。出去以后我们去哪里？",
      "pinyin": "Hǎo. Chūqu yǐhòu wǒmen qù nǎli?",
      "translationTr": "Tamam. Çıktıktan sonra nereye gidiyoruz?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc003_line_002.m4a",
      "emotion": "curious"
    },
    {
      "lineId": "HSK1_SC003_L003",
      "order": 3,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "先回家吧，你今天很累。",
      "pinyin": "Xiān huí jiā ba, nǐ jīntiān hěn lèi.",
      "translationTr": "Önce eve gidelim; bugün çok yorgunsun.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc003_line_003.m4a",
      "emotion": "caring"
    },
    {
      "lineId": "HSK1_SC003_L004",
      "order": 4,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好。家离这里远吗？",
      "pinyin": "Hǎo. Jiā lí zhèli yuǎn ma?",
      "translationTr": "Tamam. Ev buradan uzak mı?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc003_line_004.m4a",
      "emotion": "curious"
    },
    {
      "lineId": "HSK1_SC003_L005",
      "order": 5,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "不太远，坐车大概二十分钟。",
      "pinyin": "Bù tài yuǎn, zuò chē dàgài èrshí fēnzhōng.",
      "translationTr": "Çok uzak değil; araçla yaklaşık yirmi dakika.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc003_line_005.m4a",
      "emotion": "calm"
    },
    {
      "lineId": "HSK1_SC003_L006",
      "order": 6,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我们坐出租车吗？",
      "pinyin": "Wǒmen zuò chūzūchē ma?",
      "translationTr": "Taksiye mi bineceğiz?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc003_line_006.m4a",
      "emotion": "curious"
    },
    {
      "lineId": "HSK1_SC003_L007",
      "order": 7,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "对。车就在外面。",
      "pinyin": "Duì. Chē jiù zài wàimian.",
      "translationTr": "Evet. Araç hemen dışarıda.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc003_line_007.m4a",
      "emotion": "helpful"
    },
    {
      "lineId": "HSK1_SC003_L008",
      "order": 8,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好。我还不太认识这里。",
      "pinyin": "Hǎo. Wǒ hái bù tài rènshi zhèli.",
      "translationTr": "Tamam. Buraları henüz pek bilmiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc003_line_008.m4a",
      "emotion": "calm"
    },
    {
      "lineId": "HSK1_SC003_L009",
      "order": 9,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "没关系，以后我慢慢带你看。",
      "pinyin": "Méi guānxi, yǐhòu wǒ mànmàn dài nǐ kàn.",
      "translationTr": "Sorun değil; zamanla sana etrafı gösteririm.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc003_line_009.m4a",
      "emotion": "warm"
    },
    {
      "lineId": "HSK1_SC003_L010",
      "order": 10,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "谢谢。杭州看起来很漂亮。",
      "pinyin": "Xièxie. Hángzhōu kàn qǐlai hěn piàoliang.",
      "translationTr": "Teşekkürler. Hangzhou çok güzel görünüyor.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc003_line_010.m4a",
      "emotion": "happy"
    },
    {
      "lineId": "HSK1_SC003_L011",
      "order": 11,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你喜欢这里吗？",
      "pinyin": "Nǐ xǐhuan zhèli ma?",
      "translationTr": "Burayı sevdin mi?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc003_line_011.m4a",
      "emotion": "friendly"
    },
    {
      "lineId": "HSK1_SC003_L012",
      "order": 12,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "喜欢。天气也很好。",
      "pinyin": "Xǐhuan. Tiānqì yě hěn hǎo.",
      "translationTr": "Sevdim. Hava da çok güzel.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc003_line_012.m4a",
      "emotion": "happy"
    },
    {
      "lineId": "HSK1_SC003_L013",
      "order": 13,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "今天还不错。你渴吗？",
      "pinyin": "Jīntiān hái búcuò. Nǐ kě ma?",
      "translationTr": "Bugün hava fena değil. Susadın mı?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc003_line_013.m4a",
      "emotion": "caring"
    },
    {
      "lineId": "HSK1_SC003_L014",
      "order": 14,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "有一点。我想喝水。",
      "pinyin": "Yǒu yìdiǎn. Wǒ xiǎng hē shuǐ.",
      "translationTr": "Biraz. Su içmek istiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc003_line_014.m4a",
      "emotion": "calm"
    },
    {
      "lineId": "HSK1_SC003_L015",
      "order": 15,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "外面有商店，我们可以买水。",
      "pinyin": "Wàimian yǒu shāngdiàn, wǒmen kěyǐ mǎi shuǐ.",
      "translationTr": "Dışarıda bir dükkân var; su alabiliriz.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc003_line_015.m4a",
      "emotion": "helpful"
    },
    {
      "lineId": "HSK1_SC003_L016",
      "order": 16,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，那先买水，再回家。",
      "pinyin": "Hǎo, nà xiān mǎi shuǐ, zài huí jiā.",
      "translationTr": "Tamam, o zaman önce su alıp sonra eve gidelim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc003_line_016.m4a",
      "emotion": "happy"
    },
    {
      "lineId": "HSK1_SC003_L017",
      "order": 17,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "可以。出口就在前面。",
      "pinyin": "Kěyǐ. Chūkǒu jiù zài qiánmian.",
      "translationTr": "Olur. Çıkış hemen ileride.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk1_sc003_line_017.m4a",
      "emotion": "helpful"
    },
    {
      "lineId": "HSK1_SC003_L018",
      "order": 18,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，我们走吧。",
      "pinyin": "Hǎo, wǒmen zǒu ba.",
      "translationTr": "Tamam, hadi gidelim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk1_sc003_line_018.m4a",
      "emotion": "happy"
    }
  ]
}
