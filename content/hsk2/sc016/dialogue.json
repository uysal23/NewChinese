{
  "sceneId": "HSK2_SC016",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK2_SC016_L001",
      "order": 1,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "今天周末，我们多走一会儿吧。",
      "pinyin": "Jīntiān zhōumò, wǒmen duō zǒu yíhuìr ba.",
      "translationTr": "Bugün hafta sonu, biraz daha uzun yürüyelim.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc016_line_001.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L002",
      "order": 2,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，我今天时间很多。",
      "pinyin": "Hǎo, wǒ jīntiān shíjiān hěn duō.",
      "translationTr": "Olur, bugün bol vaktim var.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc016_line_002.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L003",
      "order": 3,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你想走多久？",
      "pinyin": "Nǐ xiǎng zǒu duōjiǔ?",
      "translationTr": "Ne kadar yürümek istiyorsun?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc016_line_003.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L004",
      "order": 4,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "一个小时怎么样？",
      "pinyin": "Yí ge xiǎoshí zěnmeyàng?",
      "translationTr": "Bir saat nasıl?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc016_line_004.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L005",
      "order": 5,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "可以，不过中间可以休息一下。",
      "pinyin": "Kěyǐ, búguò zhōngjiān kěyǐ xiūxi yíxià.",
      "translationTr": "Olur ama arada biraz dinlenebiliriz.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc016_line_005.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L006",
      "order": 6,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我最近走路比以前多了。",
      "pinyin": "Wǒ zuìjìn zǒulù bǐ yǐqián duō le.",
      "translationTr": "Son zamanlarda eskisine göre daha çok yürüyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc016_line_006.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L007",
      "order": 7,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "你自己感觉怎么样？",
      "pinyin": "Nǐ zìjǐ gǎnjué zěnmeyàng?",
      "translationTr": "Sen kendini nasıl hissediyorsun?",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc016_line_007.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L008",
      "order": 8,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "上楼的时候没那么累了。",
      "pinyin": "Shàng lóu de shíhou méi nàme lèi le.",
      "translationTr": "Merdiven çıkarken artık o kadar yorulmuyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc016_line_008.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L009",
      "order": 9,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "这就是慢慢坚持的好处。",
      "pinyin": "Zhè jiù shì mànmàn jiānchí de hǎochu.",
      "translationTr": "İşte düzenli devam etmenin faydası bu.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc016_line_009.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L010",
      "order": 10,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我发现走路比我想的容易坚持。",
      "pinyin": "Wǒ fāxiàn zǒulù bǐ wǒ xiǎng de róngyì jiānchí.",
      "translationTr": "Yürüyüşe devam etmenin düşündüğümden daha kolay olduğunu fark ettim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc016_line_010.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L011",
      "order": 11,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "因为不用特别准备，也不用花钱。",
      "pinyin": "Yīnwèi bú yòng tèbié zhǔnbèi, yě bú yòng huā qián.",
      "translationTr": "Çünkü özel hazırlık gerekmiyor ve para da harcamıyorsun.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc016_line_011.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L012",
      "order": 12,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "对，而且走完以后心情也比较好。",
      "pinyin": "Duì, érqiě zǒu wán yǐhòu xīnqíng yě bǐjiào hǎo.",
      "translationTr": "Evet, yürüyüşten sonra ruh halim de daha iyi oluyor.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc016_line_012.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L013",
      "order": 13,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "那边有长椅，我们到那里休息。",
      "pinyin": "Nàbiān yǒu chángyǐ, wǒmen dào nàlǐ xiūxi.",
      "translationTr": "Şurada bank var, orada dinlenelim.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc016_line_013.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L014",
      "order": 14,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，休息五分钟再继续。",
      "pinyin": "Hǎo, xiūxi wǔ fēnzhōng zài jìxù.",
      "translationTr": "Tamam, beş dakika dinlenip devam edelim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc016_line_014.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L015",
      "order": 15,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "今天不用走得太快。",
      "pinyin": "Jīntiān bú yòng zǒu de tài kuài.",
      "translationTr": "Bugün çok hızlı yürümemize gerek yok.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc016_line_015.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L016",
      "order": 16,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "对，舒服一点儿更重要。",
      "pinyin": "Duì, shūfu yìdiǎnr gèng zhòngyào.",
      "translationTr": "Evet, rahat olmak daha önemli.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc016_line_016.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L017",
      "order": 17,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "以后周末可以把这条路线走完。",
      "pinyin": "Yǐhòu zhōumò kěyǐ bǎ zhè tiáo lùxiàn zǒu wán.",
      "translationTr": "Bundan sonra hafta sonları bu rotayı tamamlayabiliriz.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc016_line_017.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC016_L018",
      "order": 18,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "好，就把它当成我们的周末习惯。",
      "pinyin": "Hǎo, jiù bǎ tā dàng chéng wǒmen de zhōumò xíguàn.",
      "translationTr": "Tamam, bunu hafta sonu alışkanlığımız yapalım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc016_line_018.m4a",
      "emotion": "natural"
    }
  ]
}
