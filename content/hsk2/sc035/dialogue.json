{
  "sceneId": "HSK2_SC035",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK2_SC035_L001",
      "order": 1,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "走了这么久，我开始饿了。",
      "pinyin": "Zǒu le zhème jiǔ, wǒ kāishǐ è le.",
      "translationTr": "Bu kadar yürüyünce acıkmaya başladım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc035_line_001.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L002",
      "order": 2,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "我也是。找个地方吃午饭吧。",
      "pinyin": "Wǒ yě shì. Zhǎo ge dìfang chī wǔfàn ba.",
      "translationTr": "Ben de. Öğle yemeği için bir yer bulalım.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc035_line_002.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L003",
      "order": 3,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "这条街的店很多。",
      "pinyin": "Zhè tiáo jiē de diàn hěn duō.",
      "translationTr": "Bu sokakta çok yer var.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc035_line_003.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L004",
      "order": 4,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "我们找一个人不太多的。",
      "pinyin": "Wǒmen zhǎo yí ge rén bú tài duō de.",
      "translationTr": "Çok kalabalık olmayan bir yer bulalım.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc035_line_004.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L005",
      "order": 5,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "那边那家看起来比较安静。",
      "pinyin": "Nàbiān nà jiā kàn qǐlái bǐjiào ānjìng.",
      "translationTr": "Şuradaki yer daha sakin görünüyor.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc035_line_005.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L006",
      "order": 6,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "可以先看看菜单和价格。",
      "pinyin": "Kěyǐ xiān kànkan càidān hé jiàgé.",
      "translationTr": "Önce menü ve fiyatlara bakabiliriz.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc035_line_006.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L007",
      "order": 7,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我想吃当地一点儿的东西。",
      "pinyin": "Wǒ xiǎng chī dāngdì yìdiǎnr de dōngxi.",
      "translationTr": "Biraz yerel bir şey yemek istiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc035_line_007.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L008",
      "order": 8,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "那可以问问有什么推荐。",
      "pinyin": "Nà kěyǐ wènwen yǒu shénme tuījiàn.",
      "translationTr": "O zaman ne önerdiklerini sorabiliriz.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc035_line_008.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L009",
      "order": 9,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "不过我不想点太多。",
      "pinyin": "Búguò wǒ bù xiǎng diǎn tài duō.",
      "translationTr": "Ama fazla sipariş vermek istemiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc035_line_009.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L010",
      "order": 10,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "两个人点两个菜加一个汤就够了。",
      "pinyin": "Liǎng ge rén diǎn liǎng ge cài jiā yí ge tāng jiù gòu le.",
      "translationTr": "İki kişi için iki yemek ve bir çorba yeter.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc035_line_010.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L011",
      "order": 11,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "如果份量很大怎么办？",
      "pinyin": "Rúguǒ fènliàng hěn dà zěnme bàn?",
      "translationTr": "Porsiyonlar çok büyükse?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc035_line_011.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L012",
      "order": 12,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "可以先问清楚。",
      "pinyin": "Kěyǐ xiān wèn qīngchu.",
      "translationTr": "Önce sorup netleştirebiliriz.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc035_line_012.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L013",
      "order": 13,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "旅行的时候我最怕点太多吃不完。",
      "pinyin": "Lǚxíng de shíhou wǒ zuì pà diǎn tài duō chī bu wán.",
      "translationTr": "Seyahatte en çok fazla sipariş verip bitirememekten çekiniyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc035_line_013.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L014",
      "order": 14,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "所以先少点，不够再加。",
      "pinyin": "Suǒyǐ xiān shǎo diǎn, bú gòu zài jiā.",
      "translationTr": "O yüzden önce az söyle, yetmezse eklersin.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc035_line_014.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L015",
      "order": 15,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "这个方法很实际。",
      "pinyin": "Zhège fāngfǎ hěn shíjì.",
      "translationTr": "Bu yöntem çok pratik.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc035_line_015.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L016",
      "order": 16,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "而且我们下午还要走很多路。",
      "pinyin": "Érqiě wǒmen xiàwǔ hái yào zǒu hěn duō lù.",
      "translationTr": "Üstelik öğleden sonra daha çok yürüyeceğiz.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc035_line_016.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L017",
      "order": 17,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "那就别吃得太饱。",
      "pinyin": "Nà jiù bié chī de tài bǎo.",
      "translationTr": "O zaman çok fazla yemeyelim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc035_line_017.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC035_L018",
      "order": 18,
      "speakerId": "CHAR_LI_NA_001",
      "textZh": "好，就去那家安静的小店。",
      "pinyin": "Hǎo, jiù qù nà jiā ānjìng de xiǎo diàn.",
      "translationTr": "Tamam, şu sakin küçük yere gidelim.",
      "voiceId": "VOICE_LI_NA_001",
      "audioFile": "assets/hsk2_sc035_line_018.m4a",
      "emotion": "natural"
    }
  ]
}
