      "order": 3,
      "file": "hsk2_sc022_line_003.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "textZh": "基本上是，不然我怕看不懂。",
      "emotion": "natural"
