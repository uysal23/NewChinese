      "order": 16,
      "file": "hsk2_sc006_line_016.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "textZh": "你说得对。我先做半小时，再休息五分钟。",
      "emotion": "natural"
