    {
      "order": 10,
      "file": "hsk2_sc006_line_010.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "textZh": "好，我们几点再一起确认？",
      "emotion": "natural"
    },
    {
      "order": 11,
      "file": "hsk2_sc006_line_011.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_WANG_MING_001",
      "textZh": "四点半怎么样？",
      "emotion": "natural"
    },
