    {
      "order": 8,
      "file": "hsk2_sc006_line_008.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "textZh": "这样可以省很多时间。",
      "emotion": "natural"
    },
    {
      "order": 9,
      "file": "hsk2_sc006_line_009.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_WANG_MING_001",
      "textZh": "你负责前面的检查，我负责后面的整理。",
      "emotion": "natural"
