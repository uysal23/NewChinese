    {
      "order": 13,
      "file": "hsk2_sc006_line_013.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_WANG_MING_001",
      "textZh": "别忘了中间休息几分钟。",
      "emotion": "natural"
