    {
      "order": 5,
      "file": "hsk2_sc006_line_005.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_WANG_MING_001",
      "textZh": "最好下班以前做完。",
      "emotion": "natural"
    },
    {
      "order": 6,
      "file": "hsk2_sc006_line_006.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "textZh": "那我原来的邮件怎么办？",
      "emotion": "natural"
