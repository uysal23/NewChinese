    {
      "order": 7,
      "file": "hsk2_sc006_line_007.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_WANG_MING_001",
      "textZh": "邮件可以晚一点儿发，我先帮你处理一部分。",
      "emotion": "natural"
