      "order": 12,
      "file": "hsk2_sc006_line_012.m4a",
      "type": "dialogue",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "textZh": "可以。那我先把最急的部分做完。",
      "emotion": "natural"
