{
  "sceneId": "HSK2_SC045",
  "status": "locked-reference",
  "lines": [
    {
      "lineId": "HSK2_SC045_L001",
      "order": 1,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我来得是不是太早了？",
      "pinyin": "Wǒ lái de shì bu shì tài zǎo le?",
      "translationTr": "Çok mu erken geldim?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc045_line_001.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L002",
      "order": 2,
      "speakerId": "CHAR_LIU_MEI_001",
      "textZh": "不会，大家还要十分钟才到。",
      "pinyin": "Bú huì, dàjiā hái yào shí fēnzhōng cái dào.",
      "translationTr": "Hayır, diğerleri on dakika sonra gelir.",
      "voiceId": "VOICE_LIU_MEI_001",
      "audioFile": "assets/hsk2_sc045_line_002.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L003",
      "order": 3,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我有一点儿紧张，不知道要不要发言。",
      "pinyin": "Wǒ yǒu yìdiǎnr jǐnzhāng, bù zhīdào yào bu yào fāyán.",
      "translationTr": "Biraz gerginim, konuşmam gerekip gerekmediğini bilmiyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc045_line_003.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L004",
      "order": 4,
      "speakerId": "CHAR_LIU_MEI_001",
      "textZh": "不用每个人都说很多。",
      "pinyin": "Bú yòng měi ge rén dōu shuō hěn duō.",
      "translationTr": "Herkesin çok konuşması gerekmiyor.",
      "voiceId": "VOICE_LIU_MEI_001",
      "audioFile": "assets/hsk2_sc045_line_004.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L005",
      "order": 5,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "那我可以先听吗？",
      "pinyin": "Nà wǒ kěyǐ xiān tīng ma?",
      "translationTr": "Önce dinleyebilir miyim?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc045_line_005.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L006",
      "order": 6,
      "speakerId": "CHAR_LIU_MEI_001",
      "textZh": "当然。想说的时候再说。",
      "pinyin": "Dāngrán. Xiǎng shuō de shíhou zài shuō.",
      "translationTr": "Elbette. İstediğinde konuşursun.",
      "voiceId": "VOICE_LIU_MEI_001",
      "audioFile": "assets/hsk2_sc045_line_006.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L007",
      "order": 7,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "今天大家聊哪本书？",
      "pinyin": "Jīntiān dàjiā liáo nǎ běn shū?",
      "translationTr": "Bugün hangi kitap konuşulacak?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc045_line_007.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L008",
      "order": 8,
      "speakerId": "CHAR_LIU_MEI_001",
      "textZh": "没有固定的一本，每个人介绍最近喜欢的内容。",
      "pinyin": "Méiyǒu gùdìng de yì běn, měi ge rén jièshào zuìjìn xǐhuan de nèiróng.",
      "translationTr": "Tek bir sabit kitap yok, herkes son zamanlarda sevdiği bir şeyi tanıtıyor.",
      "voiceId": "VOICE_LIU_MEI_001",
      "audioFile": "assets/hsk2_sc045_line_008.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L009",
      "order": 9,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "那我可以说我最近看的短故事。",
      "pinyin": "Nà wǒ kěyǐ shuō wǒ zuìjìn kàn de duǎn gùshi.",
      "translationTr": "O zaman son zamanlarda okuduğum kısa hikâyeden bahsedebilirim.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc045_line_009.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L010",
      "order": 10,
      "speakerId": "CHAR_LIU_MEI_001",
      "textZh": "很好，简单说为什么喜欢就可以。",
      "pinyin": "Hěn hǎo, jiǎndān shuō wèishénme xǐhuan jiù kěyǐ.",
      "translationTr": "Çok iyi, neden sevdiğini kısaca söylemen yeter.",
      "voiceId": "VOICE_LIU_MEI_001",
      "audioFile": "assets/hsk2_sc045_line_010.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L011",
      "order": 11,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "如果不知道一个词怎么办？",
      "pinyin": "Rúguǒ bù zhīdào yí ge cí zěnme bàn?",
      "translationTr": "Bir kelimeyi bilmezsem ne yapayım?",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc045_line_011.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L012",
      "order": 12,
      "speakerId": "CHAR_LIU_MEI_001",
      "textZh": "换简单的说法，或者直接问。",
      "pinyin": "Huàn jiǎndān de shuōfǎ, huòzhě zhíjiē wèn.",
      "translationTr": "Daha basit bir ifadeyle söyle ya da doğrudan sor.",
      "voiceId": "VOICE_LIU_MEI_001",
      "audioFile": "assets/hsk2_sc045_line_012.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L013",
      "order": 13,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "我常常因为想说得太正确而停很久。",
      "pinyin": "Wǒ chángcháng yīnwèi xiǎng shuō de tài zhèngquè ér tíng hěn jiǔ.",
      "translationTr": "Çok doğru konuşmak istediğim için sık sık uzun süre duruyorum.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc045_line_013.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L014",
      "order": 14,
      "speakerId": "CHAR_LIU_MEI_001",
      "textZh": "交流的时候先把意思说清楚更重要。",
      "pinyin": "Jiāoliú de shíhou xiān bǎ yìsi shuō qīngchu gèng zhòngyào.",
      "translationTr": "İletişimde önce anlamı açık söylemek daha önemli.",
      "voiceId": "VOICE_LIU_MEI_001",
      "audioFile": "assets/hsk2_sc045_line_014.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L015",
      "order": 15,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "这跟李娜说的一样。",
      "pinyin": "Zhè gēn Lǐ Nà shuō de yíyàng.",
      "translationTr": "Bu Li Na'nın dediğiyle aynı.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc045_line_015.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L016",
      "order": 16,
      "speakerId": "CHAR_LIU_MEI_001",
      "textZh": "看来大家都给你同样的建议。",
      "pinyin": "Kànlái dàjiā dōu gěi nǐ tóngyàng de jiànyì.",
      "translationTr": "Görünüşe göre herkes sana aynı öneriyi veriyor.",
      "voiceId": "VOICE_LIU_MEI_001",
      "audioFile": "assets/hsk2_sc045_line_016.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L017",
      "order": 17,
      "speakerId": "CHAR_ZHANG_WEI_001",
      "textZh": "那我今天就少担心语法，多听多说。",
      "pinyin": "Nà wǒ jīntiān jiù shǎo dānxīn yǔfǎ, duō tīng duō shuō.",
      "translationTr": "O zaman bugün dilbilgisini daha az düşünüp daha çok dinleyip konuşayım.",
      "voiceId": "VOICE_ZHANG_WEI_001",
      "audioFile": "assets/hsk2_sc045_line_017.m4a",
      "emotion": "natural"
    },
    {
      "lineId": "HSK2_SC045_L018",
      "order": 18,
      "speakerId": "CHAR_LIU_MEI_001",
      "textZh": "很好，活动快开始了。",
      "pinyin": "Hěn hǎo, huódòng kuài kāishǐ le.",
      "translationTr": "Çok iyi, etkinlik başlamak üzere.",
      "voiceId": "VOICE_LIU_MEI_001",
      "audioFile": "assets/hsk2_sc045_line_018.m4a",
      "emotion": "natural"
    }
  ]
}
